{% extends 'base.html.twig' %}

{% block title %}Pomiary pogodowe | Pogodynka{% endblock %}

{% block body %}
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Pomiary pogodowe</h1>
            <p class="text-secondary mb-0">Lista zapisanych danych meteorologicznych.</p>
        </div>

        <a href="{{ path('app_measurement_new') }}" class="btn btn-primary">
            + Dodaj pomiar
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-primary">
                    <tr>
                        <th scope="col" class="ps-3">ID</th>
                        <th scope="col">Miejscowość</th>
                        <th scope="col">Data pomiaru</th>
                        <th scope="col">Temperatura</th>
                        <th scope="col" class="text-end pe-3">Akcje</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for measurement in measurements %}
                        <tr>
                            <td class="ps-3">{{ measurement.id }}</td>
                            <td>
                                {% if measurement.location %}
                                    <span class="fw-semibold">{{ measurement.location.city }}</span>
                                    <span class="text-secondary small d-block">
                                        {{ measurement.location.country }}
                                    </span>
                                {% else %}
                                    <span class="text-secondary">Brak miejscowości</span>
                                {% endif %}
                            </td>
                            <td>
                                {{ measurement.date ? measurement.date|date('d.m.Y') : '—' }}
                            </td>
                            <td>
                                <span class="badge text-bg-info fs-6">
                                    {{ measurement.celsius is not null ? measurement.celsius ~ ' °C' : '—' }}
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-flex justify-content-end flex-wrap gap-2">
                                    <a href="{{ path('app_measurement_show', {'id': measurement.id}) }}"
                                       class="btn btn-outline-primary btn-sm">
                                        Szczegóły
                                    </a>
                                    <a href="{{ path('app_measurement_edit', {'id': measurement.id}) }}"
                                       class="btn btn-outline-secondary btn-sm">
                                        Edytuj
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <p class="text-secondary mb-3">Brak zapisanych pomiarów.</p>
                                <a href="{{ path('app_measurement_new') }}" class="btn btn-primary btn-sm">
                                    Dodaj pierwszy pomiar
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

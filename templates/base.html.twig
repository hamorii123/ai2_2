<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Pogodynka{% endblock %}</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% endblock %}

    <style>
        body {
            background-color: #f4f7fb;
            min-height: 100vh;
        }

        main {
            min-height: 80vh;
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_location_index') }}">
            Pogodynka
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarMenu"
            aria-controls="navbarMenu"
            aria-expanded="false"
            aria-label="Przełącz nawigację"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMenu">
            <div class="navbar-nav">
                <a class="nav-link" href="{{ path('app_location_index') }}">
                    Miejscowości
                </a>

                <a class="nav-link" href="{{ path('app_location_new') }}">
                    Dodaj miejscowość
                </a>

                <a class="nav-link" href="{{ path('app_measurement_index') }}">
                    Pomiary
                </a>

                <a class="nav-link" href="{{ path('app_measurement_new') }}">
                    Dodaj pomiar
                </a>
            </div>
        </div>
    </div>
</nav>

<main class="container py-4">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Zamknij"
            ></button>
        </div>
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>

